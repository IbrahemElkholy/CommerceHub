# Database
DB_URL=jdbc:postgresql://localhost:5432/commercehub
DB_USERNAME=commercehub
DB_PASSWORD=commercehub

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (minimum 32-character secret for HMAC-SHA256)
JWT_SECRET=replace-this-with-a-secure-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800

# Mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
